{
  "redirects": [
    {
      "source": "/admin",
      "destination": "/submissions",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/api/admin/login",
      "destination": "/api/admin/auth"
    },
    {
      "source": "/api/admin/session",
      "destination": "/api/admin/auth"
    },
    {
      "source": "/api/admin/logout",
      "destination": "/api/admin/auth"
    },
    {
      "source": "/api/admin/crm-actions",
      "destination": "/api/admin/crm?mode=actions"
    },
    {
      "source": "/api/admin/crm-activity",
      "destination": "/api/admin/crm?mode=activity"
    },
    {
      "source": "/api/admin/microsoft/start",
      "destination": "/api/admin/microsoft"
    },
    {
      "source": "/api/admin/microsoft/callback",
      "destination": "/api/admin/microsoft"
    },
    {
      "source": "/api/portal/logout",
      "destination": "/api/portal/session?mode=logout"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
