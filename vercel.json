{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self' https://www.googletagmanager.com; script-src-attr 'none'; style-src 'self' https://fonts.googleapis.com; style-src-attr 'none'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com https://region1.analytics.google.com https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; frame-src 'none'; form-action 'self'; manifest-src 'self'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "/submissions",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/api/admin/login",
      "destination": "/api/admin/auth"
    },
    {
      "source": "/api/admin/session",
      "destination": "/api/admin/auth"
    },
    {
      "source": "/api/admin/logout",
      "destination": "/api/admin/auth"
    },
    {
      "source": "/api/admin/crm-actions",
      "destination": "/api/admin/crm?mode=actions"
    },
    {
      "source": "/api/admin/crm-activity",
      "destination": "/api/admin/crm?mode=activity"
    },
    {
      "source": "/api/admin/microsoft/start",
      "destination": "/api/admin/microsoft"
    },
    {
      "source": "/api/admin/microsoft/callback",
      "destination": "/api/admin/microsoft"
    },
    {
      "source": "/api/portal/logout",
      "destination": "/api/portal/session?mode=logout"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
